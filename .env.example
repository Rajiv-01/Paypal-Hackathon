# Server Configuration
PORT=3001

# Agent Execution Mode (set to true to run without OpenAI API key)
# When true or when OPENAI_API_KEY is unset, the system uses realistic pre-recorded A2A negotiations
USE_MOCK_AGENT=true

# OpenAI Configuration (Optional if USE_MOCK_AGENT=true)
OPENAI_API_KEY=your_openai_api_key_here

# AG Studio License Key (You have this license)
VITE_AG_STUDIO_LICENSE_KEY=your_ag_studio_license_key_here

# AG Grid Enterprise License Key (Optional - simulated in Community if omitted)
VITE_AG_GRID_LICENSE_KEY=

# PayPal Configuration (for Financial Settlement)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com



